# ---------------------------------------------------------------------------
# ERPNext - Fachschaft Informatik e.V.
# In Coolify werden diese Werte unter "Environment Variables" gesetzt,
# NICHT in dieser Datei. Diese Datei ist nur die Vorlage/Dokumentation.
# ---------------------------------------------------------------------------

# Muss exakt der Domain entsprechen, unter der ERPNext erreichbar ist.
# Frappe benennt die Site danach - nachträglich ändern ist unangenehm.
SITE_NAME=buchhaltung.nak-inf.de

# Passwort des lokalen "Administrator". Nur für Ersteinrichtung und Notfälle -
# der Alltag läuft über Authentik-Login. Langes Zufallspasswort verwenden.
ADMIN_PASSWORD=

# MariaDB-Root-Passwort. Wird beim allerersten Start festgeschrieben,
# spätere Änderung erfordert Eingriff in die DB.
DB_ROOT_PASSWORD=

# Welche Frappe-Apps beim Anlegen der Site installiert werden.
# Nur ERPNext:                    erpnext
# ERPNext + DATEV-Export:         erpnext erpnext_datev
# Achtung: erpnext_datev gibt es nur im selbstgebauten Image (siehe README).
INSTALL_APPS=erpnext

# Image. Standard = offizielles Image ohne DATEV-App.
# Für DATEV: FRAPPE_IMAGE=ghcr.io/fachschaft-informatik-nordakademie/fs-erpnext
FRAPPE_IMAGE=frappe/erpnext
FRAPPE_VERSION=v16.35.0

# Host-Port, auf dem NPMplus (rammstein, 10.0.0.100) den Dienst abholt.
# Auf slipknot belegt: 3000, 5006 (Firefly INF), 5007 (Firefly BWL), 5678, 8000, 9000, 9001
ERPNEXT_HOST_PORT=5010

# IP des vorgelagerten Reverse Proxy, damit ERPNext die echte Client-IP
# im Audit-Log sieht statt der Proxy-IP.
UPSTREAM_REAL_IP_ADDRESS=10.0.0.100

# Gunicorn-Worker. 2 ist für einen Verein reichlich und schont den RAM.
GUNICORN_WORKERS=2
