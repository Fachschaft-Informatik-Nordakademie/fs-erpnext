# ---------------------------------------------------------------------------
# ERPNext - Fachschaft Informatik e.V.
# In Coolify werden diese Werte unter "Environment Variables" gesetzt,
# NICHT in dieser Datei. Diese Datei ist nur die Vorlage/Dokumentation.
# ---------------------------------------------------------------------------

# Muss exakt der Domain entsprechen, unter der ERPNext erreichbar ist.
# Frappe benennt die Site danach - nachträglich ändern ist unangenehm.
SITE_NAME=erp.nak-studis.de

# Passwort des lokalen "Administrator". Nur für Ersteinrichtung und Notfälle -
# der Alltag läuft über Authentik-Login. Langes Zufallspasswort verwenden.
ADMIN_PASSWORD=

# MariaDB-Root-Passwort. Wird beim allerersten Start festgeschrieben,
# spätere Änderung erfordert Eingriff in die DB.
DB_ROOT_PASSWORD=

# Welche Frappe-Apps beim Anlegen der Site installiert werden.
# Gilt nur für eine NEU angelegte Site - auf der bestehenden Site werden Apps
# mit "bench --site <site> install-app <app>" nachinstalliert.
# Im selbstgebauten Image liegen bereit: erpnext_germany, eu_einvoice, erpnext_datev.
INSTALL_APPS=erpnext erpnext_germany eu_einvoice

# Image. Das offizielle frappe/erpnext enthält NUR erpnext. Alles weitere
# (erpnext_germany, eu_einvoice, erpnext_datev) steckt im selbstgebauten Image
# aus .github/workflows/build-image.yml.
# FRAPPE_VERSION ist hier der COMMIT-SHA des Builds, nicht "v16.35.0": den
# Versions-Tag schiebt jeder neue Build weiter (andere Apps, gleicher Tag),
# der SHA-Tag bleibt für immer dasselbe Image. Nach einem Image-Bau also den
# neuen SHA eintragen - das ist der bewusste Update-Schritt.
FRAPPE_IMAGE=ghcr.io/fachschaft-informatik-nordakademie/fs-erpnext
FRAPPE_VERSION=de6636fe2b58c030b940862494c4919e2c207e1c

# Host-Port, auf dem NPMplus (rammstein, 10.0.0.100) den Dienst abholt.
# Auf slipknot belegt: 3000, 5006 (Firefly INF), 5007 (Firefly BWL), 5678, 8000, 9000, 9001
ERPNEXT_HOST_PORT=5010

# IP des vorgelagerten Reverse Proxy, damit ERPNext die echte Client-IP
# im Audit-Log sieht statt der Proxy-IP.
UPSTREAM_REAL_IP_ADDRESS=10.0.0.100

# Gunicorn-Worker. 2 ist für einen Verein reichlich und schont den RAM.
GUNICORN_WORKERS=2

# LAN-IP von NPMplus (rammstein). Noetig, weil mango kein NAT-Hairpin kann und der
# OIDC-Token-Tausch aus dem Container heraus sonst in die oeffentliche IP laeuft.
AUTHENTIK_LAN_IP=10.0.0.100

# LAN-IP von Mailcow (acdc). Gleicher Grund: der Mailversand aus den Worker-
# Containern muss im LAN bleiben. Der Hostname mx.stupanak.de bleibt erhalten,
# damit die TLS-Zertifikatspruefung greift. Zugangsdaten stehen nicht hier,
# sondern in ERPNext unter Email Account (Passwort im Vaultwarden).
MAILCOW_LAN_IP=10.0.0.202

# --------------------------------------------------------------------- Backup
# Zeitpunkt des taeglichen Laufs (Container-Zeitzone Europe/Berlin)
BACKUP_HOUR=3
BACKUP_MINUTE=15
# 1 = beim Containerstart sofort einmal sichern (fuer den ersten Test)
BACKUP_RUN_ON_START=0

# SSH-Zugang zum Backup-Ziel (rammstein). Privater Schluessel base64-kodiert.
# Der zugehoerige oeffentliche Schluessel liegt in rammsteins authorized_keys und
# ist dort auf "sftp-server -d /data/backups/erpnext" eingeschraenkt.
BACKUP_SSH_KEY_B64=
BACKUP_SSH_HOST=10.0.0.100
BACKUP_SSH_USER=root

# Passwort des restic-Repos. OHNE DIESES PASSWORT IST KEIN BACKUP WIEDERHERSTELLBAR.
# Gehoert in den Vaultwarden der Fachschaft.
RESTIC_PASSWORD=

# Primaeres Repo auf rammstein
RESTIC_REPOSITORY_PRIMARY=sftp:backup-target:/data/backups/erpnext/repo

# Offsite-Repo - leer lassen, solange es nicht eingerichtet ist.
# Beispiele:
#   Hetzner Storage Box : sftp:u123456@u123456.your-storagebox.de:/erpnext
#   S3-kompatibel       : s3:https://s3.example.com/fs-backups/erpnext
RESTIC_REPOSITORY_OFFSITE=
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=

# Aufbewahrung
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12

# Benachrichtigung
# BACKUP_PUSH_URL  wird NUR bei Erfolg gepingt (Uptime-Kuma-Push-Monitor):
#                  bleibt der Ping aus, schlaegt Kuma von selbst Alarm -
#                  faengt also auch den Fall "Backup lief gar nicht".
# BACKUP_WEBHOOK_URL wird NUR bei Fehlschlag aufgerufen (z.B. Discord-Webhook).
BACKUP_PUSH_URL=
BACKUP_WEBHOOK_URL=
